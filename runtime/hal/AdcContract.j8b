public interface AdcContract extends RtosDriver {
    @Native("_DRV_ADC__REF_")
    public enum AdcReference {
        EXTERNAL, //Первые значения взяты с Atmega328
        INTERNAL_CAP,
        INTERNAL_1_1V, //1.1V
        INTERNAL_2_56V;//2.56V
    }

	@Native("_DRV_ADC__MODE_")
    public enum AdcMode {
        SINGLE,
        FREE_RUNNING
//TODO        AUTO_TRIGGER
    }

    public final static byte FLAG_ENABLED = 0x00;
    public final static byte FLAG_BUSY = 0x01;

    void setChannel(byte channel)  throws DriverException;
    void setReference(AdcReference ref)  throws DriverException;
    void setPrescaler(short prescaler);
    void setMode(AdcMode mode);
    void setCallback(RtosCallback callback);

    void init(RtosCallback callback) throws DriverException;
    void start();
    void shutdown();

    boolean isEnabled();
    boolean isBusy();
    short getRawValue();

    byte getResolution();
}