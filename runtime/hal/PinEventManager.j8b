public class PinEventManager implements RtosDriver {
    public final static byte TRIGGER_MODE_FALLING	= 0b00000001;
    public final static byte TRIGGER_MODE_RISING	= 0b00000010;
    public final static byte TRIGGER_MODE_ANY		= 0b00000011;

	public PinEventManager() {}

    /**
     * Регистрирует callback на события пина.
     * @param port - пин
     * @param callback - обработчик событий
     * @triggerMode - тип события
     * @return ID регистрации (byte)
     * @throws DriverException
     */
	public static byte register(byte port, NativeCallback callback, byte triggerMode) throws DriverException {
		byte result = intRegister(port, callback, triggerMode);
		if(0x00==result) result = pcintRegister(port, callback, triggerMode);
		if(0x00==result) result = poolingRegister(port, callback, triggerMode);
		return result;
	}

	/**
 	* Освобождает регистрацию.
 	* @param id - ID регистрации (полученный от register)
 	* @throws DriverException
 	*/
	public static void unregister(byte id) throws DriverException {
		//TODO
	}

	public static native byte intRegister(byte port, NativeCallback callback, byte triggerMode);
	public static native byte pcintRegister(byte port, NativeCallback callback, byte triggerMode);
	public static native byte poolingRegister(byte port, NativeCallback callback, byte triggerMode);
}