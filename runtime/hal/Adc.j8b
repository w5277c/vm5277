@RtosFeature("OS_FT_IRQ_ADC_BLOCK")
public class Adc implements AdcContract {
    @Native("_DRV_ADC__STAT_FIELD_REF")
    private static AdcReference ref = AdcReference.INTERNAL_CAP;
    @Native("_DRV_ADC__STAT_FIELD_PRESC")
    private static byte prescaler = 64;
    @Native("_DRV_ADC__STAT_FIELD_MODE")
    private static AdcMode mode = AdcMode.SINGLE;
    @Native("_DRV_ADC__STAT_FIELD_CALLBACK")
    private static NativeCallback callback;
	@Native("_DRV_ADC__STAT_FIELD_FLAGS")
	private static byte flags;
	@Native("_DRV_ADC__STAT_FIELD_RAWVALUE")
	private static short rawValue;
	@Native("_DRV_ADC__STAT_FIELD_CHANNEL")
	private static byte channel;

    @Override static public void setPrescaler(short _prescaler) {prescaler = (byte)_prescaler;}
    @Override static public void setMode(AdcMode _mode) {mode = _mode;}
    @Override static public void setCallback(NativeCallback _callback) {callback = _callback;}
    @Override static boolean isEnabled() {return 0!=(flags&(1<<AdcContract.FLAG_ENABLED));}
    @Override static boolean isBusy() {return 0!=(flags&(1<<AdcContract.FLAG_BUSY));}
    @Override static short getRawValue() {return rawValue;}
	@Override static byte getResolution() {return 10;} // Вероятно нужно вынести в RTOS, так как вероятно не все ADC у AVR 10 битные
    @Override static public native void init(NativeCallback callback) throws DriverException;
    @Override static public native void start();
    @Override static public native void shutdown();
	// Эти параметры могу быть применены без повторного вызова init()
    @Override static public native void setChannel(byte channel) throws DriverException;
    @Override static public native void setReference(AdcReference ref) throws DriverException;

    public static short read() throws DriverException {
        start();
        return waitRawValue();
    }

    public static short waitRawValue() throws DriverException {
        while(isBusy()) {
            if(!isEnabled()) DriverException.throw(DriverException.HARDWARE_FAIL);
            Thread.sleep();
        }
        return rawValue;
    }
}