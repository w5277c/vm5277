import rtos.RtosDispatcher;

public class Bmp580 implements PressureSensor {
	public final static byte ADDR = 0x47;
	private final static byte REG_CHIP_ID = 0x01;
	private final static byte REG_TEMP_DATA = 0x1D;
	private final static byte REG_IIR_CONFIG = 0x31;
	private final static byte REG_OSR_CONFIG = 0x36;
	private final static byte REG_ODR_CONFIG = 0x37;
	private final static byte REG_CMD = 0x7E;

	private I2cMaster i2c;
	private final byte[] buffer = new byte[6];
	private fixed temp;
	private int pressure;
	private int basePressure;

	public Bmp580(I2cMaster i2c) {
		this.i2c = i2c;
	}

	public void init() throws DriverException {
		RtosDispatcher.lock();

		buffer[0] = REG_CMD;
		buffer[1] = 0xB6; //SOFT_RESET
		i2c.comm(buffer, 2, null, 0, 100);
		Thread.sleep(5);

		buffer[0] = REG_CHIP_ID;
		i2c.comm(buffer, 1, buffer, 1, 100);
		if(0x50!=buffer[0]) DriverException.throw(DriverException.UNSUPPORTED);

		buffer[0] = REG_IIR_CONFIG;
		buffer[1] = 0b00001001; //Coef 1 & 1
		i2c.comm(buffer, 2, null, 0, 100);

		buffer[0] = REG_OSR_CONFIG;
		buffer[1] = 0b01111100; //PRESS_EN=true TempX16 PresX128
		i2c.comm(buffer, 2, null, 0, 100);

		buffer[0] = REG_ODR_CONFIG;
		buffer[1] = 0b00000001 + (0x1C<<2); //DEEP_DIS=false, PWR_MODE=normal, ODR=1Hz
		i2c.comm(buffer, 2, null, 0, 100);
		RtosDispatcher.unlock();

		Thread.sleep(20);
	}

	public void acquireBasePressure() {
		read();
		basePressure = pressure;
	}

	@Override public void read() {
		RtosDispatcher.lock();
		buffer[0] = REG_TEMP_DATA;
		i2c.comm(buffer, 1, buffer, 6, 100);

		temp = Primitive.rawToFixed(buffer[2], buffer[1]);
		pressure = Primitive.rawToInt(buffer[3], buffer[4], buffer[5], 0);
		RtosDispatcher.unlock();
	}

	public fixed getCelsius() {
		return temp;
	}

	@Override public short getHpa() {
		return (short)((pressure>>8)/25);
	}

	public fixed getRelativeHeight() { // Относительная высота в метрах
		int delta;
		boolean isNegative = false;

		if(pressure>basePressure) {
			delta = pressure-basePressure;
			isNegative = true;
		}
		else {
			delta = basePressure-pressure;
		}

		basePressure = pressure;

		fixed mod = Primitive.hthToFixed((short)((delta*13)/100));
		if(isNegative) {
			return -mod;
		}
		return mod;
	}
}
