	private Layer layer;
	private byte rows;
	private byte cols;

	public HD44780(Layer layer, byte cols, byte rows) {
		this.layer = layer;
		this.cols = cols;
		this.rows = rows;

		init();
	}

	public HD44780(Layer layer) {
		this(layer, 16, 2);  // Стандартный 16x2
	}

	public HD44780(I2cMaster iface) {
		this(new Pcf8574Layer(iface), 16, 2);  // Стандартный 16x2 с PCF8574
	}

	@Override private void init() {
        // Специальная последовательность инициализации для 4-бит режима
        Thread.sleep(50);  // Ждем 50 мс после включения питания
        RtosDispatcher.lock();
        // Три раза отправляем 0x03 (функция set 8-bit)
        for (byte i=0; i<3; i++) {
            layer.setNibble(0x03, false);
            layer.pulse();
            Thread.sleep(5);
        }
        // Переключение в 4-бит режим
        layer.setNibble(0x02, false);
        layer.pulse();
        Thread.sleep(1);//RtosCore.delayUs(100);

        sendCommand(0x28); // Настройка: 2 строки, 5x8 точек, 4-бит режим
		sendCommand(0x0c); // Display ON, cursor OFF, blink OFF
		sendCommand(0x01); // Clear display
        Thread.sleep(2);
        sendCommand(0x06); // Entry mode: increment, no shift
        RtosDispatcher.unlock();
    }

    private void sendCommand(byte cmd) {
        layer.setRS(false);  // Command mode
        layer.setNibble((cmd>>4)&0x0F, false);
        layer.pulse();
        layer.setNibble(cmd&0x0F, false);
        layer.pulse();
        RtosCore.delayUs(50);
    }

    private void sendData(byte data) {
        layer.setRS(true);   // Data mode
        layer.setNibble((data>>4)&0x0F, true);
        layer.pulse();
        layer.setNibble(data&0x0F, true);
        layer.pulse();
        RtosCore.delayUs(50);
    }

	// === Реализация Display ===
	@Override public short getWidth() {return cols;}
	@Override public short getHeight() {return rows;}
	@Override public void clear() {
		sendCommand(0x01);
		Thread.sleep(2);
	}
	@Override public void update() {}
	@Override public void setBacklight(boolean st) {layer.setBacklight(st);}
	// === Реализация TextDisplay ===
	@Override void setInkColor(byte c) {}
	@Override void setPaperColor(byte c) {}
	@Override void setCursor(short x, short y) {
    	byte rowAddress = 0;
		switch(y) {
        	case 0: rowAddress = 0x00;
        	case 1: rowAddress = 0x40;
        	case 2: rowAddress = 0x14;
        	case 3: rowAddress = 0x54;
        }
		sendCommand((byte)(0x80+rowAddress+x));
    }
    
	@Override public void putChar(char c) {
		sendData((byte)c);
	}
	@Override public void setBright(byte b) {}
	@Override public byte getMaxBright() {return 0;}
	@Override public void setContrast(byte b) {}
	@Override public byte getMaxContrast() {return 0;}
}