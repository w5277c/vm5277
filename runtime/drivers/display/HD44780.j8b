import rtos.RtosDispatcher;

public class HD44780 implements TextDisplay {
	public interface Layer {
		void init();
		void setNibble(byte nibble, boolean isData);	// Отправка 4 бит
		void pulse(); // Строб E
		void setRS(boolean isData); // 0=cmd, 1=data
		void setRW(boolean isRead); // 0=write, 1=read (опционально)
		void setBacklight(boolean st);
	}

	public static class Pcf8574Layer implements Layer {
		private I2cMaster i2c;
		private final byte[] state = new byte[]{0x08};  // Backlight ON, остальные 0

		public Pcf8574Layer(I2cMaster i2c) {
            this.i2c = i2c;
		}

		@Override public void init() {
            // Начальное состояние: EN=0, RW=0, RS=0, BL=1
            i2c.comm(state, 1, null, 0, 100);
		}
		@Override public void setNibble(byte nibble, boolean isData) {
			// Упаковка: BL(1) + D7 D6 D5 D4 + EN(0) + RW(0) + RS (RS=1 для данных)
			state[0] = (0x08|(byte)((nibble&0x0f)<<4)|(isData ? 1 : 0));
		}

		@Override public void pulse() {
			state[0] |= 0x04;  // EN=1
            i2c.comm(state, 1, null, 0, 100);
			RtosCore.delayUs(1);
			state[0] &= 0xFB;  // EN=0
            i2c.comm(state, 1, null, 0, 100);
			RtosCore.delayUs(1);
		}

		@Override public void setRS(boolean isData) {
			if(isData) state[0] |= 0x01;
			else state[0] &= 0xFE;
		}

		@Override public void setRW(boolean isRead) {
			// PCF8574 не поддерживает чтение с HD44780 без доп. логики
		}

		@Override public void setBacklight(boolean st) {
            if (st) state[0] = state[0] |= 0x08;
            else state[0] = state[0] &= ~0xF7;
            i2c.comm(state, 1, null, 0, 100);
        }
	}

