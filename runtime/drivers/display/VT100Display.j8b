@RtosFeature("OS_FT_VT100")
public class VT100Display implements TextDisplay {
	private final static byte[] ESC_DATA 		= new byte[]{0x1b,'['};
	private final static byte[] CLEAR_DATA 		= new byte[]{0x1b,'[','2','J'};
	private final static byte[] HOME_DATA 		= new byte[]{0x1b,'[','H'};

	// Композиция: канал вывода
	private OutputStream os;

	// Флаги состояния
	private byte inkColor = 7;
	private byte paperColor = 0;
	private boolean inited = false;

	public VT100Display(OutputStream os) {this.os = os;}

    public void init() {
        if(inited) return;
        clear();
        os.write(HOME_DATA);
        inited = true;
    }

    @Override public short getWidth() {return 80;}
    @Override public short getHeight() {return 24;}

    @Override public void clear() {
        os.write(CLEAR_DATA);
    }

    @Override public void update() {}
    public void setBacklight(boolean on) {}

    @Override public void setCursor(short x, short y) {
        os.write(ESC_DATA);
        os.write((short)(y+1));
        os.write(';');
        os.write((short)(x+1));
        os.write('H');
    }

    @Override public void putChar(char c) {os.write(c);}
    @Override public void setInkColor(byte c) {inkColor = c; applyColors();}
    @Override public void setPaperColor(byte c) {paperColor = c; applyColors();}

    private void applyColors() {
        os.write(ESC_DATA);
        os.write((byte)(30+inkColor));
        os.write(';');
        os.write((byte)(40+paperColor));
        os.write('m');
    }
}