// I2C(I2CHM) - ведущий аппаратный драйвер двухпроводной синхронной I2C-шины,
// где SDA - двунаправленная линия данных, а SCL - линия тактирования.
@RtosFeature("OS_FT_IRQ_TWI_BLOCK")
@ExpandHeap(4)
public class I2cMasterHw implements I2cMaster {
	//WARNING! Любые изменения свойств должны быть учтены в драйвере RTOS
	//Т.к. драйвер RTOS работает с кучей напрямую.
	private byte addr;
	private	I2cFreq freq;
	private byte[] sendBuff;
	private short sendLen;
	private byte[] recvBuff;
	private short recvLen;
	private short timeout;
	private byte errCode;

	public I2cMasterHw(byte addr, I2cFreq freq) {
		this.addr = addr;
		this.freq = freq;

		init();
	}

	@Override public byte getAddr() {return addr;}
	@Override public void setAddr(byte addr) {this.addr = addr;}

	@Override public short comm(byte[] sendBuff, short sendLen, byte[] recvBuff, short recvLen, short timeout) {
		this.sendBuff = sendBuff;
		this.sendLen = (null==sendBuff ? (short)0 : sendLen);
		this.recvBuff = recvBuff;
		this.recvLen = (null==recvBuff ? (short)0 : recvLen);
		this.timeout = timeout;

		comm();
		if(DriverException.OK!=errCode) {
			DriverException.throw(errCode);
		}
		return recvLen;
	}

	public native void init();
	public native void comm();
	@Override public native void close();
}
