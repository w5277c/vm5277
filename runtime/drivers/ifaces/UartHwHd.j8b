import rtos.RtosDispatcher;

// UartHwHalf - аппаратный полудуплексный(запрос-ответ) драйвер двухпроводного UART-интерфейса,
// где RX-линия приема данных, а TX-линия передачи данных (с поддержкой пина направления).
@ExpandHeap(10)
public class UartHwHd implements RtosHalfDuplexIface, UartCommon {
	public enum State {
		READY,
		SENDING,
		BREAK,
		WAIT_DATA,
		RECEIVING,
		FAIL,
		OVERFLOW
	}

	public enum Feature {
		BREAK,			// Формирование сигнала BREAK
		MAGIC,			// Определение магического слова (2 байта) и вызов процедуры обработчика
		U2X_OFF,		// Отключение удвоеной частоты выборки
		DIR_CONTROL		// Управление дополнительным пином направления
	}

	//WARNING! Любые изменения свойств должны быть учтены в драйвере RTOS
	//Т.к. драйвер RTOS работает с кучей напрямую.
	private byte ifaceSn;
	private int baudrate;
	private	Parity parity;
	private StopBits stopBits;
	private short magic;
	private NativeCallback magicCallback;
	private	byte dirPin;
	private byte features;
	private byte state;

	public UartHwHd(byte ifaceSn, int baudrate, Parity parity, StopBits stopBits) {
		this.ifaceSn = ifaceSn;
		this.baudrate = baudrate;
		this.parity = parity;
		this.stopBits = stopBits;

	}

	public void enableMagicDetection(short magic, NativeCallback magicCallback) {
		this.magic = magic;
		this.magicCallback = magicCallback;
		this.features |= (1<<Feature.MAGIC);
	}
	public void disableMagicDetection() {
		this.features &= ~(1<<Feature.MAGIC);
	}

	public void setDirControl(byte dirPin) {
		this.dirPin = dirPin;
		this.features |= (1<<Feature.DIR_CONTROL);
	}

	private native void init() throws DriverException;
	public void open() {
		init();
	}
	public native void close();
	@Override public int getBaudrate() {return baudrate;}
	@Override public Parity getParity() {return parity;}
	@Override public StopBits getStopBits() {return stopBits;}

	@Override public native short comm(byte[] sendBuf, short sendLen, byte[] recvBuf, short recvLen, short timeout) throws DriverException;
}