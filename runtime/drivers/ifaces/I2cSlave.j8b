@RtosFeature("OS_FT_IR_TABLE")
public class I2cSlave implements RtosHalfDuplexIface, RtosDriver, Closeable {
	private byte addr;

	public I2cSlave(byte addr) {
		init(addr);
	}

	// Передача адреса и настройка прерываний
	private native void init(byte addr);

	 // Аппаратное включение и перенастройка GPIO
	public native void open();
	// Передача и прием данных
	@Override public native byte comm(byte[] sendBuf, short sendLen, byte[] recvBuf, short recvLen, short timeout);
	 // Аппаратное выключение и перенастройка GPIO
	@Override public native void close();
}