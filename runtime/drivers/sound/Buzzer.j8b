@RegisterSoftTimer(timerId)
public class Buzzer implements NativeCallback, RtosDriver {
	private byte port;
	private short ioReg;
	private	short delay;
	private final byte timerId;

	public Buzzer(byte port, short delay) {
		this.port = port;
		this.ioReg = RtosCore.getIORegOutput(port);
		this.delay = delay;
	}

	public void play(int data) {
		boolean mute = true;
		for(byte i=0; i<32; i++) {
			boolean state = 0!=(Primitive.b3(data)&0x80);
			if(!mute || state) {
				mute = false;
				if(state) {
					Gpio.modeOut(port);
					RtosCore.startSoftTimer(this, timerId, 0, 2); //2.5kHz
				}
				Thread.sleep(delay);
				if(state) {
					RtosCore.stopSoftTimer(timerId);
					Gpio.modeIn(port);
				}
			}
			data <<= 0x01;
		}
		Gpio.setLow(port);
	}

	@Override
	private void callback(byte resId) {
		RtosCore.invertIOReg(ioReg);
	}
}