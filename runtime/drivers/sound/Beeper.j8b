import hal.HwTimerManager;

public class Beeper implements BeeperCommon, NativeCallback {
	private byte port;
	private short ioReg;

	public Beeper(byte port) {
		this.port = port;
		this.ioReg = RtosCore.getIORegOutput(port);
	}

	public void play(byte[] data) throws DriverException, NativeException {
		byte timerId = 0xff;
		try {
			short delay = QUARTER_MS;
			timerId = HwTimerManager.register(FlashData.readShort(PERIODS, 0), HwTimerManager.Resolution.RES_16BIT, this, 0x00);
			short length = data.length;
			Gpio.modeOut(port);
			for(short i=0; i<length && Thread.isAlive(); i++) {
				byte b = data[i];
				if(0!=(b&0x80)) {
					delay = (short)(QUARTER_MS*2)/(b&0x3f);
					if(0!=(b&0x40)) {
						HwTimerManager.stop(timerId);
					}
					Thread.sleep(delay);
				}
				else {
					try {
						short period = FlashData.readShort(PERIODS,(short)((b&0x0f)*2))>>((b>>4)&0x07);
						if(0==period) period = 1;
						HwTimerManager.restart(timerId, period);
						Thread.sleep(delay);
					}
					catch(NativeException ex) {
						break;
					}
				}
			}
		}
		finally {
			if(0xff!=timerId) {
				HwTimerManager.unregister(timerId);
			}
			Gpio.modeIn(port);
			Gpio.setLow(port);
		}
	}

	@Override
	private void callback(byte resId) {
		RtosCore.invertIOReg(ioReg);
	}
}
