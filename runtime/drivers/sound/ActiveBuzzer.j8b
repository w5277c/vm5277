public class ActiveBuzzer implements RtosDriver {
	private byte port;
	private	short delay;

	public ActiveBuzzer(byte port, short delay) {
		this.port = port;
		this.delay = delay;
	}

	public void play(int data) {
		Gpio.modeOut(port);

		boolean mute = true;
		for(byte i=0; i<32; i++) {
			boolean state = 0!=(Primitive.b3(data)&0x80);
			if(!mute || state) {
				mute = false;
				Gpio.set(port, state);
				Thread.sleep(delay);
			}
			data <<= 0x01;
		}

		Gpio.modeIn(port);
		Gpio.setLow(port);
	}
}