public interface TimeDateDevice {
    void read();

    void set(byte dom, byte month, short year, byte dow, byte hour, byte minutes, byte seconds);

    byte getSeconds();
    byte getMinutes();
    byte getHour();
    byte getDom();
    byte getMonth();
    short getYear();
    byte getDow();

    void print(OutputStream os);
}