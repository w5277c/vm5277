public interface RtosCore {
	public static native void delayUs(byte us);
	public static native byte getUptimeB0();

	public static native void startSoftTimer(NativeCallback callback, byte sn, byte resId, short period);
	public static native void stopSoftTimer(byte resId);

	public static native short getIORegDirection(byte gpioPort);
	public static native short getIORegOutput(byte gpioPort);
	public static native short getIORegInput(byte gpioPort);
	public static native void setIORegHigh(short reg);
	public static native void setIORegLow(short reg);
	public static native void setIOReg(short reg, boolean isHigh);
	public static native void invertIOReg(short reg);
	public static native boolean getIOReg(short reg);
}