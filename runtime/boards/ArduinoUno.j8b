public interface ArduinoUno extends RtosBoard {
	// Analog pins
	public static final byte PIN_A0 = Gpio.PC0;
	public static final byte PIN_A1 = Gpio.PC1;
	public static final byte PIN_A2 = Gpio.PC2;
	public static final byte PIN_A3 = Gpio.PC3;
	public static final byte PIN_A4 = Gpio.PC4;
	public static final byte PIN_A5 = Gpio.PC5;
	// Analog channels
	public static final byte ADC_CHANNEL_A0 = 0;
	public static final byte ADC_CHANNEL_A1 = 1;
	public static final byte ADC_CHANNEL_A2 = 2;
	public static final byte ADC_CHANNEL_A3 = 3;
	public static final byte ADC_CHANNEL_A4 = 4;
	public static final byte ADC_CHANNEL_A5 = 5;
	public static final byte ADC_CHANNEL_TEMP = 8;
	// Digital
	public static final byte PIN_D0 = Gpio.PD0;
	public static final byte PIN_D1 = Gpio.PD1;
	public static final byte PIN_D2 = Gpio.PD2;
	public static final byte PIN_D3 = Gpio.PD3;
	public static final byte PIN_D4 = Gpio.PD4;
	public static final byte PIN_D5 = Gpio.PD5;
	public static final byte PIN_D6 = Gpio.PD6;
	public static final byte PIN_D7 = Gpio.PD7;
	public static final byte PIN_D8 = Gpio.PB0;
	public static final byte PIN_D9 = Gpio.PB1;
	public static final byte PIN_D10 = Gpio.PB2;
	public static final byte PIN_D11 = Gpio.PB3;
	public static final byte PIN_D12 = Gpio.PB4;
	public static final byte PIN_D13 = Gpio.PB5;
	// UART
	public static final byte PIN_RX = Gpio.PD0;
   	public static final byte PIN_TX = Gpio.PD1;
	// I2C
	public static final byte PIN_SDA = Gpio.PC4;
	public static final byte PIN_SCL = Gpio.PC5;
	// Exteranl Interrupts
	public static final byte PIN_INT0 = Gpio.PD2;
	public static final byte PIN_INT1 = Gpio.PD3;

	public static final byte LED_BUILTIN = Gpio.PB5; //=PIN_D13

   	// UART'ы
   	public static final byte UART0_SN	= 0x00;
}