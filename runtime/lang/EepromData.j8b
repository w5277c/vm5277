public class EepromData {
	 // Помещает в массив данные из Eeprom
	public static native void toBuffer(EepromData data, short dataOffset, byte[] buffer) throws NativeException;

	public static native byte readByte(EepromData data, short dataOffset) throws NativeException;
	public static native short readShort(EepromData data, short dataOffset) throws NativeException;
	public static native int readInt(EepromData data, short dataOffset) throws NativeException;

	public static native void toEeprom(EepromData data, short dataOffset, byte[] buffer) throws NativeException;
	public static native writeByte(EepromData data, short dataOffset, byte value) throws NativeException;
	public static native writeShort(EepromData data, short dataOffset, short value) throws NativeException;
	public static native writeInt(EepromData data, short dataOffset, int value) throws NativeException;
}