// Коды соответствуют RTOS OSR кодам

public exception DriverException extends RuntimeException {
	OK,
	ALLOC_FAIL,
	TIMEOUT,
	BUSY,
	INVALID_STATE,
	INVALID_DATA,
	NO_RESPONSE,
	HARDWARE_FAIL,
	INIT_FAILED,
	CHECKSUM_ERROR,
	OVERFLOW,
	CLOSED,
	UNSUPPORTED,
	NO_AVAILABLE,
	INVALID_PARAM,
	UNSUPPORTED_PARAM;
}