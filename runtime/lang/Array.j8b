public class Array {
	public static native void fill(byte[] arr, short offset, short len, byte fill) throws BoundsException;
	public static native void fill(fixed[] arr, short offset, short len, fixed fill) throws BoundsException;
	public static native void fill(short[] arr, short offset, short len, short fill) throws BoundsException;
	public static native void fill(int[] arr, short offset, short len, int fill) throws BoundsException;
	public static native void fill(Object[] arr, short offset, short len, Object fill) throws BoundsException;

	public static native void copy(byte[] srcArr, short srcOffset, byte[] dstArr, short dstOffset, short len) throws BoundsException;
	public static native void copy(fixed[] srcArr, short srcOffset, byte[] dstArr, short dstOffset, short len) throws BoundsException;
	public static native void copy(short[] srcArr, short srcOffset, byte[] dstArr, short dstOffset, short len) throws BoundsException;
	public static native void copy(int[] srcArr, short srcOffset, byte[] dstArr, short dstOffset, short len) throws BoundsException;
	public static native void copy(Object[] srcArr, short srcOffset, byte[] dstArr, short dstOffset, short len) throws BoundsException;
}
