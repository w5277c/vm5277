import drivers.CircBuffer;
import rtos.RtosDispatcher;

public interface OutputStream {
    public static void write(CircBuffer cBuff, char b) {
    	//TODO synchronized(RtosDispatcher.LOCK) {
    		while(0==cBuff.getFree()) {} // Нельзя спать, иначе может образоваться пауза при передаче
			cBuff.write(b);
		//}
    }
	public static short write(CircBuffer cBuff, byte[] buff, short off, short len) {
    	//TODO synchronized(RtosDispatcher.LOCK) {
    		short index = 0;
   			short free = cBuff.getFree();
   			if(0!=free) {
	   			for(; index<len && 0!=free; index++) {
	   				cBuff.write(buff[(short)(off+index)]);
	   		 		free--;
	   		 	}
	   		}
		//}
   		return index;
	}

    public short getFree(); //Возвращает количество доступных байт
    public void write(char c); //Передача байта
    public void write(byte[] buff, short off, short len); //Передача блока данных
    public void flush(); //Сброс буффера (незамедлительная передача)
}