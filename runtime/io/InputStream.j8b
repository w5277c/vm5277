import drivers.CircBuffer;

public interface InputStream {
     public static byte read(CircBuffer cBuff) {
     	while(0==cBuff.getAvailable()) {
     		Thread.sleep(1);
     	}
 		return cBuff.read();
 	}
	public static void read(CircBuffer cBuff, byte[] buff, short off, short len) {
 		short index = 0;
 		while(len!=index) {
 			short available = cBuff.getAvailable();
 			if(0!=available) {
             	for(; index<len && 0!=available; index++) {
 					buff[(short)(off+index)]=cBuff.read();
 					available--;
 				}
 			}
 			else Thread.sleep(1);
 		}
 	}

    public byte read(); //Блокируещее чтение байта
    public void read(byte[] buff, short off, short len); //Блокирующее чтение блока данных
    public short getAvailable(); //Возвращает количество доступных байт
}