import boards.ArduinoUno;
import drivers.display.WS2812B;

class Main {
	@FlashData({0x04,0x04,0x1f, 0x00,0x00,0x00, 0x00,0x00,0x00, 0x04,0x04,0x1f, 0x04,0x04,0x1f, 0x00,0x00,0x00, 0x00,0x00,0x00, 0x04,0x04,0x1f,
				0x00,0x00,0x00, 0x1f,0x00,0x00, 0xff,0x00,0x00, 0x00,0x00,0x00, 0x00,0x00,0x00, 0xff,0x00,0x00, 0x1f,0x00,0x00, 0x00,0x00,0x00,
				0x00,0x00,0x00, 0x1f,0x00,0x00, 0xff,0x00,0x00, 0xff,0x00,0x00, 0xff,0x00,0x00, 0xff,0x00,0x00, 0x1f,0x00,0x00, 0x00,0x00,0x00,
				0x00,0x00,0x00, 0x1f,0x00,0x00, 0xff,0x00,0x00, 0xff,0x00,0x00, 0xff,0x00,0x00, 0xff,0x00,0x00, 0x1f,0x00,0x00, 0x00,0x00,0x00,
				0x0f,0x0f,0x0f, 0x00,0x00,0x00, 0x1f,0x00,0x00, 0xff,0x00,0x00, 0xff,0x00,0x00, 0x1f,0x00,0x00, 0x00,0x00,0x00, 0x0f,0x0f,0x0f,
				0x0f,0x0f,0x0f, 0x0f,0x0f,0x0f, 0x00,0x00,0x00, 0x1f,0x00,0x00, 0x1f,0x00,0x00, 0x00,0x00,0x00, 0x0f,0x0f,0x0f, 0x0f,0x0f,0x0f,
				0x0f,0x0f,0x0f, 0x0f,0x0f,0x0f, 0x0f,0x0f,0x0f, 0x00,0x00,0x00, 0x00,0x00,0x00, 0x0f,0x0f,0x0f, 0x0f,0x0f,0x0f, 0x0f,0x0f,0x0f,
				0x00,0x01,0x00, 0x00,0x02,0x00, 0x00,0x04,0x00, 0x00,0x08,0x00, 0x00,0x08,0x00, 0x00,0x04,0x00, 0x00,0x02,0x00, 0x00,0x01,0x00})
	public final static FlashData FLASH_DATA;

	public static void main() {
		System.setParam(RtosParam.SHOW_WELCOME,0x01);

		try {
			WS2812B ws = new WS2812B(ArduinoUno.PIN_D7, 8, 8);
			for(byte i=0; i<30; i++) {
				for(byte y=0; y<8; y++) {
					for(byte x=0; x<8; x++) {
						ws.drawPixel(x, y, Primitive.rawToInt(0, System.random()/16, System.random()/16, System.random()/16));
					}
				}
				ws.update();
				Thread.sleep(30);
			}

			byte[] buffer = new byte[64*3];
			FlashData.toBuffer(FLASH_DATA, 0, buffer);
			ws.drawImage(buffer, 0, 0, 8, 8);
		}
		catch(Exception ex) {
			System.out(ex);
		}
		//System.showDramUsage(); //TODO не вижу освобождения памяти буфера
	}
}
