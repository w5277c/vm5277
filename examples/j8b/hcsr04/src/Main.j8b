import boards.ArduinoUno;
import drivers.sensor.Hcsr04;

// Реализация драйвера не корректная - слишком большая ошибка измерения.
//TODO необходим менеджер реализующий таймер (останавливающийся по событию) аналогично PinEventManager.register


class Main {
	public static void main() {
		System.setParam(RtosParam.SHOW_WELCOME, 1);

		Hcsr04 sens = new Hcsr04(ArduinoUno.PIN_D7, ArduinoUno.PIN_D6, 75);
		while(true) {
			try {
				sens.read();
				System.out("Distance:" + sens.getMm() + "[mM]\n");
			}
			catch(DriverException ex) {
				System.out(ex);
			}
			Thread.sleep(500);
		}
	}
}
