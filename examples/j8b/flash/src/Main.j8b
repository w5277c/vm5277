class Main {
	@FlashData({'v','m',0x35,0x32,0x37,0x37,0x00})
	private static final FlashData DATA;

	public static void main() {
		byte[] arr = new byte[7];
		try {
			FlashData.toBuffer(DATA,0,arr);
			System.out("Массив:0x");
			System.outHex(arr);
			System.out("\nByte по смещению 0x05:0x");
			System.outHex(FlashData.readByte(DATA, 0x05));
			System.out("\nShort по смещению 0x04:0x");
			System.outHex(FlashData.readShort(DATA, 0x04));
			System.out("\nInt по смещению 0x02:0x");
			System.outHex(FlashData.readInt(DATA, 0x02));
			System.out("\nБайт за пределами блока:0x");
			System.outHex(FlashData.readByte(DATA, 0x07));
		}
		catch(NativeException ex) {
			System.out(ex);
		}
	}
}
