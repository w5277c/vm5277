import drivers.ifaces.UartHwFd;
import drivers.hid.CH9329;

class Main {
	public static void main() {
		System.setParam(RtosParam.SHOW_WELCOME, 1);

		UartHwFd uart = new UartHwFd(UartCommon.BAUDRATE_9600);
		CH9329 ch = new CH9329(uart);
		//System.out("Mouse right click sending...");
		//ch.mouseClick(1<<CH9329.MOUSE_KEYBIT_RIGHT);
		System.out("Mouse move...");
		ch.mouseMove((fixed)10,(fixed)10);
		Thread.sleep(100);
		ch.mouseMove(-10.0,-10.0);
		System.out("done.\n");
	}
}
