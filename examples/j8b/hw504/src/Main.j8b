import boards.ArduinoUno;
import hal.Adc;

class Main {
	public static void main() {
		System.setParam(RtosParam.SHOW_WELCOME, 1);

		Gpio.modeIn(ArduinoUno.PIN_A0);
		Gpio.setLow(ArduinoUno.PIN_A0);
		Gpio.modeIn(ArduinoUno.PIN_A1);
		Gpio.setLow(ArduinoUno.PIN_A1);
		Gpio.modeIn(ArduinoUno.PIN_D7);
		Gpio.setHigh(ArduinoUno.PIN_D7);

		Adc.init(null);
		Adc.setChannel(ArduinoUno.ADC_CHANNEL_A0);
		short centerX = Adc.read();
		Adc.setChannel(ArduinoUno.ADC_CHANNEL_A1);
		short centerY = Adc.read();

		while(true) {
			Adc.init(null);

			boolean released = Gpio.get(ArduinoUno.PIN_D7);
			Adc.setChannel(ArduinoUno.ADC_CHANNEL_A0);
			short vrX = Adc.read();
			Adc.setChannel(ArduinoUno.ADC_CHANNEL_A1);
			short vrY = Adc.read();

			Adc.shutdown();

			System.out("x:");
			if(vrX<centerX) System.out("-" + (centerX-vrX));
			else System.out(vrX-centerX);
			System.out(", y:");
			if(vrY<centerY) System.out("-" + (centerY-vrY));
			else System.out(vrY-centerY);
			System.out(", pressed:" + !released + "\n");
			Thread.sleep(500);
		}
	}
}
