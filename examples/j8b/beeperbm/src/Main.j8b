import boards.ArduinoUno;
import drivers.sound.BeeperCommon;

class Main {
	@FlashData({0x90,0x40,0xd0,0x40,0xd0,0x40,0xd0,0x43,0xd0,0x41,0xd0,0x40,0xd0,0x3b,0xd0,0x40})
	private static final FlashData DATA;

	public static void main() throws NativeException {
		short delay = BeeperCommon.QUARTER_MS;
		for(byte i=0; i<0x10; i++) {
			byte b = asmReadByte(DATA, i);
			if(0!=(b&0x80)) {
				delay = (short)(BeeperCommon.QUARTER_MS*2)/(b&0x3f);
				if(0!=(b&0x40)) {
					asmStop();
				}
				Thread.sleep(delay);
			}
			else {
				short period = asmReadShort(BeeperCommon.PERIODS,(byte)(((byte)(b&0x0f))*2))>>((b>>4)&0x07);
				asmPlay(period);
				Thread.sleep(delay);
			}
		}
	}

	private static native void asmPlay(short period);
	private static native void asmStop();
	private static native byte asmReadByte(FlashData data, byte offset);
	private static native short asmReadShort(FlashData data, byte offset);
}
