import drivers.display.HD44780;
import drivers.ifaces.I2cMasterHw;

class Main {
	public static void main() {
		System.setParam(RtosParam.SHOW_WELCOME, 1);

		try {
			TextDisplay td = new HD44780(new Pcf8574Layer(new I2cMasterHw(0x27, I2cMaster.I2cFreq.F400kHz)), 16, 02); //TODO должна быть ошибка так как Pcf8574 - вложенный класс
			//TextDisplay td = new HD44780(new HD44780.Pcf8574Layer(new I2cMasterHw(0x27, I2cMaster.I2cFreq.F400kHz)), 16, 02); //TODO правильный синтаксис
			while(true) {
				td.setCursor(System.random()&0x0f,System.random()&0x01);
				td.putChar(0x20+(System.random()&0x7f));
				Thread.sleep(10);
			}
		}
		catch(DriverException ex) {
			System.out("Сбой HD44780, код:" + ex.code());
		}
	}
}
