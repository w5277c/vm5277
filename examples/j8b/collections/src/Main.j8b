import collections.ByteArrayList;

class Main {
	public static void main() {
		ByteArrayList bal = new ByteArrayList(8);
		System.outHex(bal.getData());
		System.out('\n');

   		System.showDramUsage();

		bal.add(3);
		System.out("Add 0x03, result:");
		System.outHex(bal.getData());
		System.out('\n');

		bal.add(3);
		System.out("Add 0x03, result:");
		System.outHex(bal.getData());
		System.out('\n');

		bal.add(0x18);
		System.out("Add 0x18, result:");
		System.outHex(bal.getData());
		System.out('\n');

		bal.set(1,50);
		System.out("Set 0x32 to 0x01, result:");
		System.outHex(bal.getData());
		System.out('\n');

		bal.add(0xff);
		System.out("Add 0xff, result:");
		System.outHex(bal.getData());
		System.out('\n');

		if(bal.contains(0x32)) {
			System.out("Collection contains 0x32\n");
		}
		else {
			System.out("Collection doesn't contain 0x32\n");
		}

		if(bal.contains(0x09)) {
			System.out("Collection contains 0x09\n");
		}
		else {
			System.out("Collection doesn't contain 0x09\n");
		}

		bal.remove(3);
		System.out("Remove, index 0x03, result:");
		System.outHex(bal.getData());
		System.out('\n');

		bal.remove(1);
		System.out("Remove, index 0x01, result:");
		System.outHex(bal.getData());
		System.out('\n');

		bal.swap(0,1);
		System.out("Swap indexes 0, 1, result:");
		System.outHex(bal.getData());
		System.out('\n');

   		System.showDramUsage();

		for(byte b=0; b<68; b++) {
			bal.add(b);
		}
		System.out("Add value range 0-67, result:");
		System.outHex(bal.getData());
   		System.out('\n');

   		System.out("Collection size:" + bal.size() + "\n");
   		System.showDramUsage();
		for(byte b=0; b<8; b++) {
			bal.remove(0);
		}
		System.out("Remove first 8, result:");
		System.outHex(bal.getData());
		System.out('\n');
   		System.out("Collection size:" + bal.size() + "\n");
   		System.showDramUsage();
		System.out("Uptime:" + System.uptimeMs() + "ms\n");
	}
}
