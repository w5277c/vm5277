class Main {
    public static void main() {
		System.setParam(RtosParam.SHOW_WELCOME,1);

		byte[][] b1 = new byte[4][5];
		System.out("b1[][] длина [4]:" + b1.length + '\n');
		byte cntr = 1;
		for(byte i=0; i<4; i++) {
			for(byte j=0; j<5; j++) {
				b1[i][j]=cntr++;
			}
		}

		System.out("b1[][] дамп [1-20]:\n");
		for(byte i=0; i<4; i++) {
			for(byte j=0; j<5; j++) {
				System.out(b1[i][j]);
				System.out(' ');
			}
			System.out('\n');
		}
		byte[] b2 = b1[3];
		System.out("Применение VIEW, оригинал b1[3][1], [17]: " + b1[3][1] + " vs вью b2[1] [17]: " + b2[1] + '\n');

		byte[] arr = new byte[10];
		short s = arr.length;
		System.out("arr[] длина, [10]: " + s + '\n');
		for(byte i=0; i<s; i++) {
			arr[i]=(byte)(i+100);
		}

		System.out("arr[] дамп [100-109]: ");
		for(byte i=0; i<10; i++) {
			System.out(arr[i]);
			System.out(' ');
		}
		System.out('\n');

		byte[][] matrix = new byte[3][3];
		matrix[0][1] = matrix[1][0];
		System.out("Значение matrix[0][1], [0]: " + matrix[0][1] + '\n');

		System.out("Сумма ячеек arr[0]+arr[1], [201]: " + (arr[0] + arr[1]) + '\n');
		System.out("method1 для arr, [101]: " + method1(arr) + '\n');
		System.out("method2, [3]: " + method2(2)[1] + '\n');

		arr[method3()] = 55;
		System.out("arr[method3()], содержит [55]: " + arr[3] + '\n');
		byte b = arr[method3()];
		System.out("b [55]: " + b + '\n');

		arr[0]++;
		--arr[0];

//System.out("1:"+(arr[0]-95) + "\n");
//System.out("2:"+(arr[arr[0]-95]-96) + "\n");
//System.out("3:"+(arr[arr[arr[0]-95]-96]) + "\n");
//System.out("4:"+(method1(arr)-94) + "\n");
//System.out("5:"+(arr[method1(arr)-94]) + "\n");
//System.out("6:"+(method2(5)[0]) + "\n");

		arr[arr[arr[0]-95]-96] = (byte)(arr[method1(arr)-94] + method2(5)[0]);
		System.out("arr[arr[arr[0]]], содержит [111]: " + arr[9] + '\n');
	}

	public static byte method1(byte[] barr) {
		return barr[1];
	}

	public static byte[] method2(byte b) {
		byte[] arr = new byte[b]; //TODO нет автоматического приведения типа byte -> short
		arr[0] = 4;
		arr[1] = 3;
		return arr;
	}

	public static byte method3() {
		return 3;
	}
}
