import boards.ArduinoUno;

class Main {
    public static void main() {
		Gpio.modeOut(ArduinoUno.PIN_D7);
		Gpio.modeOut(ArduinoUno.PIN_D6);
		Gpio.modeOut(ArduinoUno.PIN_D5);
		Gpio.modeOut(ArduinoUno.PIN_D4);

		System.out("Включаем реле на порту D7\n");
		Gpio.setHigh(ArduinoUno.PIN_D7);
		Thread.sleep(300);
		System.out("Включаем реле на порту D6\n");
		Gpio.setHigh(ArduinoUno.PIN_D6);
		Thread.sleep(300);
		System.out("Включаем реле на порту D5\n");
		Gpio.setHigh(ArduinoUno.PIN_D5);
		Thread.sleep(300);
		System.out("Включаем реле на порту D4\n");
		Gpio.setHigh(ArduinoUno.PIN_D4);

		System.out("Ждем 3 секунды\n");
		Thread.sleep(3000);

		System.out("Выключаем все реле\n");
		Gpio.setLow(ArduinoUno.PIN_D7);
		Gpio.setLow(ArduinoUno.PIN_D6);
		Gpio.setLow(ArduinoUno.PIN_D5);
		Gpio.setLow(ArduinoUno.PIN_D4);
    }
}
