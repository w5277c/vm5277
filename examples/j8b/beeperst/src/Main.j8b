import boards.ArduinoUno;
import drivers.sound.BeeperStatic;

class Main {
	@Melody("/32-c4-p-c4-p-c4-p-d#4-p-c#4-p-c4-p-b3-p-c4")
	private static final FlashData DATA;

	public static void main() {
		System.out("Необходимо подключение динамика на GND и порт D7 (Arduino-uno)\n");
		System.out("Проигрывание мелодии в статическом методе...");
		try {
			BeeperStatic.play(ArduinoUno.PIN_D7, DATA);
		}
		catch(Exception ex) {
			System.out(ex);
		}
		System.out("завершено.\n");
	}
}
