//TODO нужны статические импорты
import boards.ArduinoUno;
import drivers.display.HW069Display;

class Main {
	public static void main() {
		System.setParam(RtosParam.SHOW_WELCOME, 1);

		HW069Display disp = new HW069Display(ArduinoUno.PIN_D7, ArduinoUno.PIN_D6);
		disp.init();
		disp.putChar('H');
		disp.putChar('E');
		disp.putSymbol(HW069Display.SYMBOL_LL);
		disp.putChar('O');
		disp.update();
		Thread.sleep(2000);

		disp.setCursor(0,0);
		disp.putChar('C');
		disp.putChar('O');
		disp.putChar('D');
		disp.putChar('E');
		disp.update();

		Thread.sleep(1000);
		disp.setColon(true);
		disp.update();
		Thread.sleep(1000);
		disp.setCursor(0,0);
		disp.putChar('B');
		disp.putChar('A');
		disp.putChar('B');
		disp.putChar('E');
		disp.update();

		Thread.sleep(1000);
		disp.setColon(false);
		disp.update();
		Thread.sleep(1000);

		disp.clear();
		while(true) for(byte i=0; i<6; i++) {
			disp.setCursor(0,0);
			disp.putSymbol((byte)(1<<i));
			disp.update();
			Thread.sleep(50);
		}
	}
}
