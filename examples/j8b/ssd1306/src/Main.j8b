import drivers.display.Ssd1306;
import drivers.ifaces.I2cMasterHw;

class Main {
	public static void main() {
		System.setParam(RtosParam.SHOW_WELCOME, 1);

		try {
			GraphicsDisplay gd = new Ssd1306(new I2cLayer(new I2cMasterHw(0x3c, I2cMaster.I2cFreq.F400kHz)), 128, 32);
			System.out('A');
			byte[] image = new byte[] {0x83,0x85,0x89,0x91,0xA1,0xC1,0x81,0x83, 0xC3,0x66,0x3C,0x18,0x18,0x3C,0x66,0xC3};
			System.out('B');
			gd.drawImage(image, 0, 0, 16, 8);
			System.out('C');
		}
		catch(DriverException ex) {
			System.out("Сбой SSD1306, код:" + ex.code());
		}
	}
}
