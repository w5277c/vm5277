import drivers.display.Ssd1306;
import drivers.ifaces.I2cMasterHw;
import fonts.Ascii8x8Cw90;

class Main {
	public static void main() {
		System.setParam(RtosParam.SHOW_WELCOME, 1);
		byte[] charBuffer = new byte[Ascii8x8Cw90.CHAR_SIZE];

		try {
			GraphicsDisplay gd = new Ssd1306(new I2cLayer(new I2cMasterHw(0x3c, I2cMaster.I2cFreq.F400kHz)), 128, 32);

			byte[] text = new byte[] {'V', 'M', '5', '2', '7', '7', '!'};
			short startX = 36;
			short startY = 8;

			for(short i=0; i<text.length; i++) {
				byte asciiCode = text[i];
				short flashOffset = (short)((asciiCode - 0x20) * Ascii8x8Cw90.CHAR_SIZE);
				FlashData.toBuffer(Ascii8x8Cw90.DATA, flashOffset, charBuffer);
				short currentX = (short)(startX + (i * 8));
				gd.drawImage(charBuffer, currentX, startY, 8, 8);
			}
		}
		catch(DriverException ex) {
			System.out("Сбой SSD1306, код:" + ex.code());
		}
		catch(NativeException ex) {
			System.out(ex);
		}
	}
}
