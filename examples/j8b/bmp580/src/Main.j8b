import drivers.sensor.Bmp580;
import drivers.ifaces.I2cMasterHw;

class Main {
	public static void main() {
		System.setParam(RtosParam.SHOW_WELCOME,1);
		System.out("Fetching BMP580 sensor data (temperature & pressure).\n");
		// Опрашиваем датчик
		Bmp580 sensor = new Bmp580(new I2cMasterHw(Bmp580.ADDR, I2cMaster.I2cFreq.F100kHz));
		sensor.init();

		Thread.sleep(1500);
		sensor.acquireBasePressure();
		while(true) {
			try {
				sensor.read();
				System.out("Temperature:" + sensor.getCelsius() + "C, ");
				System.out("Pressure:" + sensor.getHpa() + "hPa, ");
				System.out("Relative height:" + sensor.getRelativeHeight() + "m\n");
			}
			catch(DriverException ex) {
				System.out("Сбой, код: " + ex.code() + '\n');
			}
			Thread.sleep(2000);
		}
	}
}
