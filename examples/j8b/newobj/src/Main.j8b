class Main {
	public interface Number {
		byte toByte();
	}

	public class Byte implements Number {
		private	byte	value;

		public Byte(byte value) {
			this.value = value;
		}

		@Override public byte toByte() {
			return value;
		}

//unsupported yet
//		public void finalize() {
//		}
	}

    public static void main() {
		System.setParam(RtosParam.SHOW_WELCOME, 0x01);

		Byte b1 = new Byte(0x01);
		System.out("b1.toByte() [1]=" + b1.toByte() + '\n');
		
		Byte b2 = new Byte(0x02);
		System.out("b2.toByte() [2]=" + b2.toByte() + '\n');

		Byte b3 = new Byte(0x01);
		System.out("b3.typeId() [?]=" + b3.typeId() + '\n');
		System.out("b3.instanceId() [?]:");
		System.outHex(b3.instanceId());
		System.out('\n');

		Byte b4 = b1;
		if(b1==b2) {
			System.out("b1==b2 [fail]\n");
		}
		else {
			System.out("b1!=b2 [ok]\n");
		}
		if(b1==b4) {
			System.out("b1==b4 [ok]\n");
		}
		else {
			System.out("b1!=b4 [fail]\n");
		}
	}
}
