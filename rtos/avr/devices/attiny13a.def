	.include "attiny13a.asm"
	.include "devices/_common.def"

;---CONSTANTS-----------------------------------------------
	.SET	_MCALL_SIZE								= 0x01	;Размер макроса MCALL/MJMP: 1(RCALL)-2(CALL)
	.SET	JMP_SUPPORT								= 0x00	;Поддержка JMP,CALL
	.SET	MUL_SUPPORT								= 0x00	;Поддержка MUL,MULS,MULSU
	.SET    SBI_TOGGLE_SUPPORT                      = 0x01  ;Аппаратное переключение пина порта через инструкцию SBI
	.SET	BLDRSEC_SUPPORT							= 0x00	;Аппаратная защита секции бутлоадера
	.EQU	OS_IR_QNT								= 0x0a	;Количество перырваний
    .EQU	OS_INT_PINS_QNT 						= 0x01	;Количество пинов поддерживающих внешние прерывания(INT)
	.EQU	OS_PCINT_PORTS_QNT						= 0x01	;Количество портов поддерживающих внешние прерывания(PCINT)
	.EQU	OS_RAM_BORDER_SIZE						= 0x01	;Минимальное допустимое расстояние между вершинами FREE_RAM и STACK
    .EQU    OS_PORTS_LAST                           = 0x01  ;Номер последнего порта (A-0,B-1,C-2,D-3,E-4,...)
	.EQU	OS_ADC_CHANNELS_QNT						= 0x04	;Количество каналов ADC

.IFNDEF OS_STACK_SIZE
	.SET	OS_STACK_SIZE							= -1	;Общий стек(-1 - вся свободная память)
.ENDIF
.IFNDEF OS_STDIN_CBUFFER_SIZE
	.SET	OS_STDIN_CBUFFER_SIZE					= 0x04	;Размер буфера ввода (не менее 4)
.ENDIF
.IFNDEF OS_ETRACE_BUFFER_SIZE
	.SET	OS_ETRACE_BUFFER_SIZE					= 0x03	;Размер буфера для трассировки исключений
.ENDIF

	.EQU	SCK										= PB2
	.EQU	MISO									= PB1
	.EQU	MOSI									= PB0

	.SET	INT0_PORT								= PB1

	;---IR---
	.EQU	OS_IRQ_INT0								= 0x00
	.EQU	OS_IRQ_PCINT0							= 0x05
	.EQU	OS_IRQ_TIMER0_OVF						= 0x0a
	.EQU	OS_IRQ_EE_READY							= 0x0f
	.EQU	OS_IRQ_ANALOG_COMP						= 0x14
	.EQU	OS_IRQ_RESERVED_CORE_TIMER				= 0x19
	.EQU	OS_IRQ_TIMER0_COMPB						= 0x1e
	.EQU	OS_IRQ_WDT								= 0x23
	.EQU	OS_IRQ_ADC								= 0x28

;TODO пока нет идей как реализовать диспетчерезацию прерываний не используя RAM
.ORG 0x0000
	RJMP	_OS_INIT										; Reset Handler
.IF OS_FT_IR_TABLE == 0x01
	RJMP	_OS_INIT	    								; External Interrupt0 Handler
	RJMP	_OS_INIT    									; Pin Change Interrupt Request 0
	RJMP	_OS_INIT		    							; Timer/Counter0 Overflow
	RJMP	_OS_INIT			    						; EEPROM Ready
	RJMP	_OS_INIT				    					; Analog Comparator
.IF OS_FT_TIMER == 0x01										; Timer/Counter0 Compare Match A
	RJMP	_OS_SYSTIMER_HANDLER
.ELSE
	RJMP	_OS_INIT
.ENDIF
	RJMP	_OS_INIT			    						; Timer/Counter0 Compare Match B
	RJMP	_OS_INIT		    							; Watchdog Time-out Interrupt
	RJMP	_OS_INIT	    								; ADC Conversion Complete
.ENDIF
PORTS_TABLE:												;Таблица из адресов IO PINx регистров (-,B)
	.db	0x00,0x36
PORTS_MASK:												    ;Таблица реальных портов(пинов)
.IF OS_RESET_DISABLE==0
    .db 0x00,0x1f
.ELSE
    .db 0x00,0x3f
.ENDIF
PCINT_TABLE:
	.db	0x00,PCMSK0
INT_TABLE:
	.db	INT0_PORT,0x00

.MACRO MCALL
	RCALL @0
.ENDMACRO
.MACRO MJMP
	RJMP @0
.ENDMACRO

;ATOMIC_REQUIRED
.MACRO _OS_POWER_ON
	PUSH ACCUM_L
	LDS ACCUM_L,PRR
	ANDI ACCUM_L,low(~(1<<@0))
	STS PRR,ACCUM_L
	POP ACCUM_L
.ENDMACRO
;ATOMIC_REQUIRED
.MACRO _OS_POWER_OFF
	PUSH ACCUM_L
	LDS ACCUM_L,PRR
	ORI ACCUM_L,low(1<<@0)
	STS PRR,ACCUM_L
	POP ACCUM_L
.ENDMACRO

;ATOMIC_REQUIRED
.MACRO _OS_TIMER_INIT_NR
	_OS_POWER_ON PRTIM0										;Подпитываю TIMER0
	LDI ACCUM_L,(1<<WGM01)|(0<<WGM00)
	STS TCCR0A,ACCUM_L
	LDI ACCUM_L,(0<<CS02)|(1<<CS01)|(0<<CS00)				;/8
	STS TCCR0B,ACCUM_L
	STS TCNT0,C0x00
	LDI ACCUM_L,_OS_TIMER_FREQ-0x01
	STS OCR0A,ACCUM_L
	LDI ACCUM_L,(1<<OCF0A)
	STS TIFR0,ACCUM_L
	LDI ACCUM_L,(1<<OCIE0A)
	STS TIMSK0,ACCUM_L
.ENDMACRO
