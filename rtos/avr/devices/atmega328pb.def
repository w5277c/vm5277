;TODO скопировано из atmega328p - добавить функционал

	.include "atmega328p.asm"
	.include "devices/_common.def"

;---CONSTANTS-----------------------------------------------
	.SET	_MCALL_SIZE								= 0x02	;Размер макроса MCALL/MJMP: 1(RCALL)-2(CALL)
	.SET	JMP_SUPPORT								= 0x01	;Поддержка JMP,CALL
	.SET	MUL_SUPPORT								= 0x01	;Поддержка MUL,MULS,MULSU
	.SET    SBI_TOGGLE_SUPPORT                      = 0x01  ;Аппаратное переключение пина порта через инструкцию SBI
	.SET	BLDRSEC_SUPPORT							= 0x01	;Аппаратная защита секции бутлоадера
	.EQU	OS_IR_QNT								= 0x1a	;Количество перырваний
	.EQU	OS_INT_PINS_QNT						    = 0x02	;Количество пинов поддерживающих внешние прерывания(INT)
	.EQU	OS_PCINT_PORTS_QNT						= 0x04	;Количество портов поддерживающих внешние прерывания(PCINT)
	.EQU	OS_RAM_BORDER_SIZE						= 0x20	;Минимальное допустимое расстояние между вершинами FREE_RAM и STACK
	.EQU    OS_PORTS_LAST                           = 0x04  ;Номер последнего порта (A-0,B-1,C-2,D-3,E-4,...)
	.EQU	OS_ADC_CHANNELS_QNT						= 0x09	;Количество каналов ADC

.IFNDEF OS_STACK_SIZE
	.SET	OS_STACK_SIZE							= 0xc0	;Общий стек(192 байта)
.ENDIF
.IFNDEF OS_STDIN_CBUFFER_SIZE
	.SET	OS_STDIN_CBUFFER_SIZE					= 0x10	;Размер буфера ввода (не менее 4)
.ENDIF
.IFNDEF OS_ETRACE_BUFFER_SIZE
	.SET	OS_ETRACE_BUFFER_SIZE					= 0x10	;Размер буфера для трассировки исключений
.ENDIF

	.EQU	SDA										= PC4
	.EQU	SCL										= PC5
	.EQU	RXD										= PD0
	.EQU	TXD										= PD1
	.EQU	RXD0									= RXD
	.EQU	TXD0									= TXD
	.EQU	SCK										= PB5
	.EQU	MISO									= PB4
	.EQU	MOSI									= PB3
	.EQU	SS										= PB2
	.EQU	OC2A									= PB3

	.SET	INT0_PORT								= PD2
	.SET	INT1_PORT								= PD3

.IF OS_FT_BOOTLOADER_ONLY == 0x00							; Пропускаем блок для сборки только бутлоадера
.ORG 0x0000
	JMP		_OS_INIT										; Reset Handler
.IF OS_FT_IR_TABLE==0x01
;----INT----------------------------------------------------
.IF OS_FT_IRQ_INT_BLOCK==0x01
	RCALL	_OS_IRQ_HANDLER								    ; External Interrupt0 Handler
	.SET OS_IRQ_INT0 = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
	RCALL	_OS_IRQ_HANDLER								    ; External Interrupt1 Handler
	.SET OS_IRQ_INT1 = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
.ELSE
    JMP		_OS_INIT										; Failure -> reset
    JMP		_OS_INIT										; Failure -> reset
.ENDIF
;----PCINT--------------------------------------------------
.IF OS_FT_IRQ_PCINT_BLOCK==0x01
	RCALL	_OS_IRQ_PCINT_HANDLER						    ; Pin Change Interrupt Request 0
	.SET OS_IRQ_PCINT0 = _OS_IRQ_RAM_TABLE_SIZE
	.DB _OS_IRQ_RAM_TABLE_SIZE, 0x10                        ;0x10->PORTB,PCINT0
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
	RCALL	_OS_IRQ_PCINT_HANDLER						    ; Pin Change Interrupt Request 1
	.SET OS_IRQ_PCINT1 = _OS_IRQ_RAM_TABLE_SIZE
	.DB _OS_IRQ_RAM_TABLE_SIZE, 0x21                        ;0x21->PORTC,PCINT1
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
	RCALL	_OS_IRQ_PCINT_HANDLER						    ; Pin Change Interrupt Request 2
	.SET OS_IRQ_PCINT2 = _OS_IRQ_RAM_TABLE_SIZE
	.DB _OS_IRQ_RAM_TABLE_SIZE, 0x32                        ;0x32->PORTD,PCINT2
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
.ELSE
    JMP		_OS_INIT										; Failure -> reset
    JMP		_OS_INIT										; Failure -> reset
    JMP		_OS_INIT										; Failure -> reset
.ENDIF
;----WATCHDOG-----------------------------------------------
.IF OS_FT_IRQ_WD_BLOCK==0x01
	RCALL	_OS_IRQ_HANDLER								    ; Watchdog Time-out Interrupt
	.SET OS_IRQ_WDT = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
.ELSE
    JMP		_OS_INIT										; Failure -> reset
.ENDIF
;----TIMER--------------------------------------------------
.IF OS_FT_IRQ_TIMER_BLOCK==0x01
	RCALL	_OS_IRQ_HANDLER								    ; Timer/Counter2 Compare Match A
	.SET OS_IRQ_TIMER2_CMPA = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
	RCALL	_OS_IRQ_HANDLER								    ; Timer/Counter2 Compare Match B
	.SET OS_IRQ_TIMER2_CMPB = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
	RCALL	_OS_IRQ_HANDLER								    ; Timer/Counter2 Overflow
	.SET OS_IRQ_TIMER2_OVF = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
.ELSE
    JMP		_OS_INIT										; Failure -> reset
    JMP		_OS_INIT										; Failure -> reset
    JMP		_OS_INIT										; Failure -> reset
.ENDIF
;----TIMER CAPTURE------------------------------------------
.IF OS_FT_IRQ_TIMER_CAPTURE_BLOCK==0x01
	RCALL	_OS_IRQ_HANDLER								    ; Timer/Counter1 Capture Event
	.SET OS_IRQ_TIMER1_CAPTURE = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
.ELSE
    JMP		_OS_INIT										; Failure -> reset
.ENDIF
;----TIMER--------------------------------------------------
.IF OS_FT_IRQ_TIMER_BLOCK==0x01
	RCALL	_OS_IRQ_HANDLER								    ; Timer/Counter1 Compare Match A
    .SET OS_IRQ_TIMER1_CMPA = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
	RCALL	_OS_IRQ_HANDLER								    ; Timer/Counter1 Compare Match B
	.SET OS_IRQ_TIMER1_CMPB = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
	RCALL	_OS_IRQ_HANDLER								    ; Timer/Counter1 Overflow
	.SET OS_IRQ_TIMER1_OVF = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
    .IF OS_FT_TIMER == 0x01									; Timer/Counter0 Compare Match A
    	JMP		_OS_SYSTIMER_HANDLER
    .ELSE
	    RCALL	_OS_IRQ_HANDLER
    	.SET OS_IRQ_TIMER0_CMPA = _OS_IRQ_RAM_TABLE_SIZE
	    .DW _OS_IRQ_RAM_TABLE_SIZE
	    .SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
    .ENDIF
	RCALL	_OS_IRQ_HANDLER								    ; Timer/Counter0 Compare Match B
	.SET OS_IRQ_TIMER0_CMPB = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
	RCALL	_OS_IRQ_HANDLER								    ; Timer/Counter0 Overflow
	.SET OS_IRQ_TIMER0_OVF = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
.ELSE
    JMP		_OS_INIT										; Failure -> reset
    JMP		_OS_INIT										; Failure -> reset
    JMP		_OS_INIT										; Failure -> reset
    JMP		_OS_INIT										; Failure -> reset
    JMP		_OS_INIT										; Failure -> reset
    JMP		_OS_INIT										; Failure -> reset
.ENDIF
;----SPI----------------------------------------------------
.IF OS_FT_IRQ_SPI_BLOCK==0x01
	RCALL	_OS_IRQ_HANDLER								    ; SPI Serial Transfer Complete
	.SET OS_IRQ_SPI0 = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
.ELSE
    JMP		_OS_INIT										; Failure -> reset
.ENDIF
;----UART---------------------------------------------------
.IF OS_FT_IRQ_UART_BLOCK==0x01
	RCALL	_OS_IRQ_HANDLER								    ; USART Rx Complete
	.SET OS_IRQ_UART0_RX = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
	RCALL	_OS_IRQ_HANDLER								    ; USART, Data Register Empty
	.SET OS_IRQ_UART0_UDRE = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
	RCALL	_OS_IRQ_HANDLER								    ; USART, Tx Complete
    .SET OS_IRQ_UART0_TX = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
.ELSE
    JMP		_OS_INIT										; Failure -> reset
    JMP		_OS_INIT										; Failure -> reset
    JMP		_OS_INIT										; Failure -> reset
.ENDIF
;----ADC----------------------------------------------------
.IF OS_FT_IRQ_ADC_BLOCK==0x01
	RCALL	_OS_IRQ_HANDLER								    ; ADC Conversion Complete
	.SET OS_IRQ_ADC = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
.ELSE
    JMP		_OS_INIT										; Failure -> reset
.ENDIF
;----EEPROM-------------------------------------------------
.IF OS_FT_IRQ_EEPROM_BLOCK==0x01
	RCALL	_OS_IRQ_HANDLER								    ; EEPROM Ready
	.SET OS_IRQ_EEPROM = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
.ELSE
    JMP		_OS_INIT										; Failure -> reset
.ENDIF
;----ANALOG CMP---------------------------------------------
.IF OS_FT_IRQ_ANALOG_CMP_BLOCK==0x01
	RCALL	_OS_IRQ_HANDLER								    ; Analog Comparator
	.SET OS_IRQ_ANALOG_COMP = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
.ELSE
    JMP		_OS_INIT										; Failure -> reset
.ENDIF
;----TWI----------------------------------------------------
.IF OS_FT_IRQ_TWI_BLOCK==0x01
	RCALL	_OS_IRQ_HANDLER								    ; 2-wire Serial Interface
	.SET OS_IRQ_TWI0 = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
.ELSE
    JMP		_OS_INIT										; Failure -> reset
.ENDIF
;----SPM ready----------------------------------------------
.IF OS_FT_IRQ_SPM_BLOCK==0x01
	RCALL	_OS_IRQ_HANDLER								    ; Store Program Memory Ready
	.SET OS_IRQ_SPM = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
.ELSE
    JMP		_OS_INIT										; Failure -> reset
.ENDIF
;----UART0 start--------------------------------------------
.IF OS_FT_IRQ_UART_BLOCK==0x01
	RCALL	_OS_IRQ_HANDLER								    ; UART start frame detection
	.SET OS_IRQ_UART0_START = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
.ELSE
	JMP		_OS_INIT										; Failure -> reset
.ENDIF
;----PCINT--------------------------------------------------
.IF OS_FT_IRQ_PCINT_BLOCK==0x01
	RCALL	_OS_IRQ_PCINT_HANDLER						    ; Pin Change Interrupt Request 3
	.SET OS_IRQ_PCINT3 = _OS_IRQ_RAM_TABLE_SIZE
	.DB _OS_IRQ_RAM_TABLE_SIZE, 0x10                        ;0x43->PORTE,PCINT3
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
.ELSE
	JMP		_OS_INIT										; Failure -> reset
.ENDIF
;----UART---------------------------------------------------
.IF OS_FT_IRQ_UART_BLOCK==0x01
	RCALL	_OS_IRQ_HANDLER								    ; USART Rx Complete
	.SET OS_IRQ_UART1_RX = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
	RCALL	_OS_IRQ_HANDLER								    ; USART, Data Register Empty
	.SET OS_IRQ_UART1_UDRE = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
	RCALL	_OS_IRQ_HANDLER								    ; USART Tx Complete
	.SET OS_IRQ_UART1_TX = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
	RCALL	_OS_IRQ_HANDLER								    ; UART start frame detection
	.SET OS_IRQ_UART1_START = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
.ELSE
	JMP		_OS_INIT										; Failure -> reset
	JMP		_OS_INIT										; Failure -> reset
	JMP		_OS_INIT										; Failure -> reset
	JMP		_OS_INIT										; Failure -> reset
.ENDIF
.ENDIF
;----TIMER CAPTURE------------------------------------------
.IF OS_FT_IRQ_TIMER_CAPTURE_BLOCK==0x01
	RCALL	_OS_IRQ_HANDLER								    ; Timer/Counter3 Capture Event
	.SET OS_IRQ_TIMER3_CAPTURE = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
.ELSE
	JMP		_OS_INIT										; Failure -> reset
.ENDIF
;----TIMER--------------------------------------------------
.IF OS_FT_IRQ_TIMER_BLOCK==0x01
	RCALL	_OS_IRQ_HANDLER								    ; Timer/Counter3 Compare Match A
	.SET OS_IRQ_TIMER3_CMPA = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
	RCALL	_OS_IRQ_HANDLER								    ; Timer/Counter3 Compare Match B
	.SET OS_IRQ_TIMER3_CMPB = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
	RCALL	_OS_IRQ_HANDLER								    ; Timer/Counter3 Overflow
	.SET OS_IRQ_TIMER3_OVF = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
.ELSE
	JMP		_OS_INIT										; Failure -> reset
	JMP		_OS_INIT										; Failure -> reset
	JMP		_OS_INIT										; Failure -> reset
.ENDIF
;----CFD----------------------------------------------------
	JMP		_OS_INIT										; Failure -> reset
;----PTC----------------------------------------------------
.IF OS_FT_IRQ_PTC_BLOCK==0x01
	RCALL	_OS_IRQ_HANDLER								    ; PTC End of Conversion
	.SET OS_IRQ_PTC_EOC = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
	RCALL	_OS_IRQ_HANDLER								    ; PTC Window comparator mode
	.SET OS_IRQ_PTC_WCOMP = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
.ELSE
	JMP		_OS_INIT										; Failure -> reset
	JMP		_OS_INIT										; Failure -> reset
.ENDIF
;----SPI----------------------------------------------------
.IF OS_FT_IRQ_SPI_BLOCK==0x01
	RCALL	_OS_IRQ_HANDLER								    ; SPI Serial Transfer Complete
	.SET OS_IRQ_SPI1 = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
.ELSE
	JMP		_OS_INIT										; Failure -> reset
.ENDIF
;----TWI----------------------------------------------------
.IF OS_FT_IRQ_TWI_BLOCK==0x01
	RCALL	_OS_IRQ_HANDLER								    ; 2-wire Serial Interface
	.SET OS_IRQ_TWI1 = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
.ELSE
	JMP		_OS_INIT										; Failure -> reset
.ENDIF
;----TIMER CAPTURE------------------------------------------
.IF OS_FT_IRQ_TIMER_CAPTURE_BLOCK==0x01
	RCALL	_OS_IRQ_HANDLER								    ; Timer/Counter4 Capture Event
	.SET OS_IRQ_TIMER4_CAPTURE = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
.ELSE
	JMP		_OS_INIT										; Failure -> reset
.ENDIF
;----TIMER--------------------------------------------------
.IF OS_FT_IRQ_TIMER_BLOCK==0x01
	RCALL	_OS_IRQ_HANDLER								    ; Timer/Counter3 Compare Match A
	.SET OS_IRQ_TIMER4_CMPA = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
	RCALL	_OS_IRQ_HANDLER								    ; Timer/Counter3 Compare Match B
	.SET OS_IRQ_TIMER4_CMPB = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
	RCALL	_OS_IRQ_HANDLER								    ; Timer/Counter3 Overflow
	.SET OS_IRQ_TIMER4_OVF = _OS_IRQ_RAM_TABLE_SIZE
	.DW _OS_IRQ_RAM_TABLE_SIZE
	.SET	_OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
.ELSE
	JMP		_OS_INIT										; Failure -> reset
	JMP		_OS_INIT										; Failure -> reset
	JMP		_OS_INIT										; Failure -> reset
.ENDIF
.ENDIF

;TODO можно оптимизировать - проверять на включенную фичу
PORTS_TABLE:												;Таблица из адресов IO PINx регистров (-,B,C,D)
	.db	0x00,0x23,0x26,0x29
PORTS_MASK:												    ;Таблица реальных портов(пинов)
.IF OS_INT_RC_OSCIL==0 && OS_RESET_DISABLE==0
    .db 0x00,0x3f,0x3f,0xff,0x0f
.ELIF OS_INT_RC_OSCIL==0 && OS_RESET_DISABLE==1
    .db 0x00,0x3f,0x7f,0xff,0x0f
.ELIF OS_INT_RC_OSCIL==1 && OS_RESET_DISABLE==0
    .db 0x00,0xff,0x3f,0xff,0x0f
.ELIF OS_INT_RC_OSCIL==1 && OS_RESET_DISABLE==1
    .db 0x00,0xff,0x7f,0xff,0x0f
.ENDIF
.IF OS_FT_IRQ_INT_BLOCK==0x01
INT_TABLE:
	.db	INT0_PORT,INT1_PORT
.ENDIF
.IF OS_FT_IRQ_PCINT_BLOCK==0x01
PCINT_TABLE: ;TODO рудимент?
	.db	0x00,PCMSK0,PCMSK1,PCMSK2,PCMSK3,0x00
.ENDIF
.ENDIF

.MACRO MCALL
	CALL @0
.ENDMACRO
.MACRO MJMP
	JMP @0
.ENDMACRO

;ATOMIC_REQUIRED
.MACRO _OS_POWER_ON
	PUSH ACCUM_L
	LDS ACCUM_L,PRR
	ANDI ACCUM_L,low(~(1<<@0))
	STS PRR,ACCUM_L
	POP ACCUM_L
.ENDMACRO
;ATOMIC_REQUIRED
.MACRO _OS_POWER_OFF
	PUSH ACCUM_L
	LDS ACCUM_L,PRR
	ORI ACCUM_L,low(1<<@0)
	STS PRR,ACCUM_L
	POP ACCUM_L
.ENDMACRO

;ATOMIC_REQUIRED
.MACRO _OS_SYSTIMER_INIT_NR
	_OS_POWER_ON PRTIM0										;Подпитываю TIMER0
	LDI ACCUM_L,(1<<WGM01)|(0<<WGM00)
	STS TCCR0A,ACCUM_L
	LDI ACCUM_L,(0<<CS02)|(1<<CS01)|(0<<CS00)				;/8
	STS TCCR0B,ACCUM_L
	STS TCNT0,C0x00
	LDI ACCUM_L,_OS_TIMER_FREQ-0x01
	STS OCR0A,ACCUM_L
	LDI ACCUM_L,(1<<OCF0A)
	STS TIFR0,ACCUM_L
	LDI ACCUM_L,(1<<OCIE0A)
	STS TIMSK0,ACCUM_L
.ENDMACRO
