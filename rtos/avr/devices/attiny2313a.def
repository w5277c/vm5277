	.include "attiny2313a.asm"
	.include "devices/_common.def"

;---CONSTANTS-----------------------------------------------
	.SET	_MCALL_SIZE								= 0x01	;Размер макроса MCALL/MJMP: 1(RCALL)-2(CALL)
	.SET	JMP_SUPPORT								= 0x00	;Поддержка JMP,CALL
	.SET	MUL_SUPPORT								= 0x00	;Поддержка MUL,MULS,MULSU
	.SET    SBI_TOGGLE_SUPPORT                      = 0x01  ;Аппаратное переключение пина порта через инструкцию SBI
	.SET	BLDRSEC_SUPPORT							= 0x00	;Аппаратная защита секции бутлоадера
	.EQU	OS_IR_QNT								= 0x15	;Количество перырваний
    .EQU	OS_INT_PINS_QNT						    = 0x02	;Количество пинов поддерживающих внешние прерывания(INT)
	.EQU	OS_PCINT_PORTS_QNT						= 0x03	;Количество портов поддерживающих внешние прерывания(PCINT)
	.EQU	OS_RAM_BORDER_SIZE						= 0x01	;Минимальное допустимое расстояние между вершинами FREE_RAM и STACK
    .EQU    OS_PORTS_LAST                           = 0x03  ;Номер последнего порта (A-0,B-1,C-2,D-3,E-4,...)
	.EQU	OS_ADC_CHANNELS_QNT						= 0x00	;Количество каналов ADC

.IFNDEF OS_STACK_SIZE
	.SET	OS_STACK_SIZE							= -1	;Общий стек(-1 - вся свободная память)
.ENDIF
.IFNDEF OS_STDIN_CBUFFER_SIZE
	.SET	OS_STDIN_CBUFFER_SIZE					= 0x04	;Размер буфера ввода (не менее 4)
.ENDIF
.IFNDEF OS_ETRACE_BUFFER_SIZE
	.SET	OS_ETRACE_BUFFER_SIZE					= 0x03	;Размер буфера для трассировки исключений
.ENDIF

	.EQU	RXD										= PD0
	.EQU	TXD										= PD1
	.EQU	RXD0									= RXD
	.EQU	TXD0									= TXD
	.EQU	SCK										= PB7
	.EQU	MISO									= PB6
	.EQU	MOSI									= PB5

	.SET	INT0_PORT								= PD2
	.SET	INT1_PORT								= PD3

	;---IR---
	.EQU	OS_IRQ_INT0								= 0x00
	.EQU	OS_IRQ_INT1								= 0x05
	.EQU	OS_IRQ_TIMER1_CAPT						= 0x0a
	.EQU	OS_IRQ_TIMER1_COMPA						= 0x0f
	.EQU	OS_IRQ_TIMER1_OVF						= 0x14
	.EQU	OS_IRQ_TIMER0_OVF						= 0x19
	.EQU	OS_IRQ_UART_RX							= 0x1e
	.EQU	OS_IRQ_UART_UDRE						= 0x23
	.EQU	OS_IRQ_UART_TX							= 0x28
	.EQU	OS_IRQ_ANALOG_COMP						= 0x2d
	.EQU	OS_IRQ_PCINT0							= 0x32
	.EQU	OS_IRQ_TIMER1_COMPB						= 0x37
	.EQU	OS_IRQ_RESERVED_CORE_TIMER				= 0x3c
	.EQU	OS_IRQ_TIMER0_COMPB						= 0x41
	.EQU	OS_IRQ_USI_START						= 0x46
	.EQU	OS_IRQ_USI_OVF							= 0x4b
	.EQU	OS_IRQ_EE_READY							= 0x50
	.EQU	OS_IRQ_WDT								= 0x55
	.EQU	OS_IRQ_PCINT1							= 0x5a
	.EQU	OS_IRQ_PCINT2							= 0x5f

.IF OS_FT_BOOTLOADER_ONLY==0x01								; Важно точно рассчитать _OS_INIT в прошивке
	.EQU	_OS_INIT = OS_IR_QNT*_MCALL_SIZE+0x04+0x04+0x02
.ELSE														; Пропускаем блок для сборки только бутлоадера
.ORG 0x0000
	RJMP	_OS_INIT										; Reset Handler
.IF OS_FT_IR_TABLE == 0x01
;----INT----------------------------------------------------
.IF OS_FT_IRQ_INT_BLOCK == 0x01
	RCALL	_OS_IRQ_HANDLER									; External Interrupt0 Handler
	RCALL	_OS_IRQ_HANDLER									; External Interrupt1 Handler
.ELSE
    JMP _OS_INIT
    JMP _OS_INIT
.ENDIF
;----TIMER CAPTURE------------------------------------------
.IF OS_FT_IRQ_TIMER_CAPTURE_BLOCK==0x01
	RCALL	_OS_IRQ_HANDLER									; Timer/Counter1 Capture Event
.ELSE
    JMP _OS_INIT
.ENDIF
;----TIMER--------------------------------------------------
.IF OS_FT_IRQ_TIMER_BLOCK==0x01
	RCALL	_OS_IRQ_HANDLER									; Timer/Counter1 Compare Match A
	RCALL	_OS_IRQ_HANDLER									; Timer/Counter1 Overflow
	RCALL	_OS_IRQ_HANDLER									; Timer/Counter0 Overflow
.ELSE
    JMP _OS_INIT
    JMP _OS_INIT
    JMP _OS_INIT
.ENDIF
;----UART---------------------------------------------------
.IF OS_FT_IRQ_UART_BLOCK==0x01
	RCALL	_OS_IRQ_HANDLER									; USART Rx Complete
	RCALL	_OS_IRQ_HANDLER									; USART, Data Register Empty
	RCALL	_OS_IRQ_HANDLER									; USART, Tx Complete
.ELSE
    JMP _OS_INIT
    JMP _OS_INIT
    JMP _OS_INIT
.ENDIF
;----ANALOG CMP---------------------------------------------
.IF OS_FT_IRQ_ANALOG_CMP_BLOCK==0x01
	RCALL	_OS_IRQ_HANDLER									; Analog Comparator
.ELSE
    JMP _OS_INIT
.ENDIF
;----PCINT--------------------------------------------------
.IF OS_FT_IRQ_PCINT_BLOCK == 0x01
	RCALL	_OS_IRQ_PCINT_HANDLER							; Pin Change Interrupt Request 0
.ELSE
    JMP _OS_INIT
.ENDIF
;----TIMER--------------------------------------------------
.IF OS_FT_IRQ_TIMER_BLOCK==0x01
	RCALL	_OS_IRQ_HANDLER									; Timer/Counter1 Compare Match B
.IF OS_FT_TIMER == 0x01										; Timer/Counter0 Compare Match A
	RJMP	_OS_SYSTIMER_HANDLER
.ELSE
	RCALL	_OS_IRQ_HANDLER
.ENDIF
	RCALL	_OS_IRQ_HANDLER									; Timer/Counter0 Compare Match B
.ELSE
    JMP _OS_INIT
    JMP _OS_INIT
    JMP _OS_INIT
.ENDIF
;----USI----------------------------------------------------
.IF OS_FT_IRQ_USI_BLOCK==0x01
	RCALL	_OS_IRQ_HANDLER									; USI Start Condition
	RCALL	_OS_IRQ_HANDLER									; USI Overflow
.ELSE
    JMP _OS_INIT
    JMP _OS_INIT
.ENDIF
;----EEPROM-------------------------------------------------
.IF OS_FT_IRQ_EEPROM_BLOCK==0x01
	RCALL	_OS_IRQ_HANDLER									; EEPROM Ready
.ELSE
    JMP _OS_INIT
.ENDIF
;----WATCHDOG-----------------------------------------------
.IF OS_FT_IRQ_WD_BLOCK==0x01
	RCALL	_OS_IRQ_HANDLER									; Watchdog Time-out Interrupt
.ELSE
    JMP _OS_INIT
.ENDIF
;----PCINT--------------------------------------------------
.IF OS_FT_IRQ_PCINT_BLOCK == 0x01
	RCALL	_OS_IRQ_PCINT_HANDLER							; Pin Change Interrupt Request 1
	RCALL	_OS_IRQ_PCINT_HANDLER							; Pin Change Interrupt Request 2
.ELSE
    JMP _OS_INIT
    JMP _OS_INIT
.ENDIF
.ENDIF

;TODO можно оптимизировать - проверять на включенную фичу
PORTS_TABLE:												;Таблица из адресов IO PINx регистров (A,B,-,D)
	.db	0x39,0x36,0xff,0x30
PORTS_MASK:												    ;Таблица реальных портов(пинов)
.IF OS_INT_RC_OSCIL==0 && OS_RESET_DISABLE==0
    .db 0x00,0xff,0x00,0x7f
.ELIF OS_INT_RC_OSCIL==0 && OS_RESET_DISABLE==1
    .db 0x04,0xff,0x00,0x7f
.ELIF OS_INT_RC_OSCIL==1 && OS_RESET_DISABLE==0
    .db 0x03,0xff,0x00,0x7f
.ELIF OS_INT_RC_OSCIL==1 && OS_RESET_DISABLE==1
    .db 0x07,0xff,0x00,0x7f
.ENDIF
PCINT_TABLE:
	.db	PCMSK0, PCMSK1, 0x00, PCMSK2
INT_TABLE:
	.db	INT0_PORT,INT1_PORT

_OS_IRQ_RAM_OFFSETS:
;----INT----------------------------------------------------
.IF _OS_FT_IRQ_INT_BLOCK==0x01
    .SET OS_IRQ_INT0 = _OS_IRQ_RAM_TABLE_SIZE
    .SET _OS_IRQ_RAM_OFFSETS_B0 = _OS_IRQ_RAM_TABLE_SIZE
    _OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
    .SET OS_IRQ_INT1 = _OS_IRQ_RAM_TABLE_SIZE
    .SET _OS_IRQ_RAM_OFFSETS_B1 = _OS_IRQ_RAM_TABLE_SIZE
    _OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
.ELSE
    .SET _OS_IRQ_RAM_OFFSETS_B0 = 0x00
    .SET _OS_IRQ_RAM_OFFSETS_B1 = 0x00
.ENDIF
    .db _OS_IRQ_RAM_OFFSETS_B0,_OS_IRQ_RAM_OFFSETS_B1
;----TIMER CAPTURE------------------------------------------
.IF OS_FT_IRQ_TIMER_CAPTURE_BLOCK==0x01
    .SET OS_IRQ_TIMER1_CAPTURE = _OS_IRQ_RAM_TABLE_SIZE
    .SET _OS_IRQ_RAM_OFFSETS_B0 = _OS_IRQ_RAM_TABLE_SIZE
    _OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
.ELSE
    .SET _OS_IRQ_RAM_OFFSETS_B0 = 0x00
.ENDIF
;----TIMER--------------------------------------------------
.IF OS_FT_IRQ_TIMER1_CMPA_BLOCK==0x01
    .SET OS_IRQ_TIMER1_CMPA = _OS_IRQ_RAM_TABLE_SIZE
    .SET _OS_IRQ_RAM_OFFSETS_B1 = _OS_IRQ_RAM_TABLE_SIZE
    _OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
    .SET OS_IRQ_TIMER1_OVF = _OS_IRQ_RAM_TABLE_SIZE
    .SET _OS_IRQ_RAM_OFFSETS_B2 = _OS_IRQ_RAM_TABLE_SIZE
    _OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
    .SET OS_IRQ_TIMER0_OVF = _OS_IRQ_RAM_TABLE_SIZE
    .SET _OS_IRQ_RAM_OFFSETS_B3 = _OS_IRQ_RAM_TABLE_SIZE
    _OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE

.ELSE
    .SET _OS_IRQ_RAM_OFFSETS_B1 = 0x00
    .SET _OS_IRQ_RAM_OFFSETS_B2 = 0x00
    .SET _OS_IRQ_RAM_OFFSETS_B3 = 0x00
.ENDIF
    .db _OS_IRQ_RAM_OFFSETS_B0,_OS_IRQ_RAM_OFFSETS_B1,_OS_IRQ_RAM_OFFSETS_B2,_OS_IRQ_RAM_OFFSETS_B3
;----UART---------------------------------------------------
.IF _OS_FT_IRQ_UART_BLOCK==0x01
    .SET OS_IRQ_UART0_RX = _OS_IRQ_RAM_TABLE_SIZE
    .SET _OS_IRQ_RAM_OFFSETS_B0 = _OS_IRQ_RAM_TABLE_SIZE
    _OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
    .SET OS_IRQ_UART0_UDRE = _OS_IRQ_RAM_TABLE_SIZE
    .SET _OS_IRQ_RAM_OFFSETS_B1 = _OS_IRQ_RAM_TABLE_SIZE
    _OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
    .SET OS_IRQ_UART0_TX = _OS_IRQ_RAM_TABLE_SIZE
    .SET _OS_IRQ_RAM_OFFSETS_B2 = _OS_IRQ_RAM_TABLE_SIZE
    _OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
.ELSE
    .SET _OS_IRQ_RAM_OFFSETS_B0 = 0x00
    .SET _OS_IRQ_RAM_OFFSETS_B1 = 0x00
    .SET _OS_IRQ_RAM_OFFSETS_B2 = 0x00
.ENDIF
;----ANALOG CMP---------------------------------------------
.IF OS_FT_IRQ_ANALOG_CMP_BLOCK==0x01
    .SET OS_IRQ_ANALOG_CMP = _OS_IRQ_RAM_TABLE_SIZE
    .SET _OS_IRQ_RAM_OFFSETS_B3 = _OS_IRQ_RAM_TABLE_SIZE
    _OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
.ELSE
    .SET _OS_IRQ_RAM_OFFSETS_B3 = 0x00
.ENDIF
    .db _OS_IRQ_RAM_OFFSETS_B0,_OS_IRQ_RAM_OFFSETS_B1,_OS_IRQ_RAM_OFFSETS_B2,_OS_IRQ_RAM_OFFSETS_B3
;----PCINT--------------------------------------------------
.IF _OS_FT_IRQ_PCINT_BLOCK==0x01
    .SET OS_IRQ_PCINT0 = _OS_IRQ_RAM_TABLE_SIZE
    .SET _OS_IRQ_RAM_OFFSETS_B0 = _OS_IRQ_RAM_TABLE_SIZE
    _OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
.ELSE
    .SET _OS_IRQ_RAM_OFFSETS_B0 = 0x00
.ENDIF
;----TIMER--------------------------------------------------
.IF OS_FT_IRQ_TIMER_BLOCK==0x01
    .SET OS_IRQ_TIMER1_CMPB = _OS_IRQ_RAM_TABLE_SIZE
    .SET _OS_IRQ_RAM_OFFSETS_B1 = _OS_IRQ_RAM_TABLE_SIZE
    _OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
    .SET _OS_IRQ_RAM_OFFSETS_B2 = 0x00
.IF OS_FT_TIMER == 0x00
    .SET OS_IRQ_TIMER0_CMPA = _OS_IRQ_RAM_TABLE_SIZE
    .SET _OS_IRQ_RAM_OFFSETS_B2 = _OS_IRQ_RAM_TABLE_SIZE
    _OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
.ENDIF
    .SET OS_IRQ_TIMER0_CMPB = _OS_IRQ_RAM_TABLE_SIZE
    .SET _OS_IRQ_RAM_OFFSETS_B3 = _OS_IRQ_RAM_TABLE_SIZE
    _OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
.ELSE
    .SET _OS_IRQ_RAM_OFFSETS_B1 = 0x00
    .SET _OS_IRQ_RAM_OFFSETS_B2 = 0x00
    .SET _OS_IRQ_RAM_OFFSETS_B3 = 0x00
.ENDIF
    .db _OS_IRQ_RAM_OFFSETS_B0,_OS_IRQ_RAM_OFFSETS_B1,_OS_IRQ_RAM_OFFSETS_B2,_OS_IRQ_RAM_OFFSETS_B3
;----USI----------------------------------------------------
.IF OS_FT_IRQ_USI_BLOCK==0x01
    .SET OS_IRQ_USI_START = _OS_IRQ_RAM_TABLE_SIZE
    .SET _OS_IRQ_RAM_OFFSETS_B0 = _OS_IRQ_RAM_TABLE_SIZE
    _OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
    .SET OS_IRQ_USI_OVF = _OS_IRQ_RAM_TABLE_SIZE
    .SET _OS_IRQ_RAM_OFFSETS_B1 = _OS_IRQ_RAM_TABLE_SIZE
    _OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
.ELSE
    .SET _OS_IRQ_RAM_OFFSETS_B0 = 0x00
    .SET _OS_IRQ_RAM_OFFSETS_B1 = 0x00
.ENDIF
    .db _OS_IRQ_RAM_OFFSETS_B0,_OS_IRQ_RAM_OFFSETS_B1
;----EEPROM-------------------------------------------------
.IF OS_FT_IRQ_EEPROM_BLOCK==0x01
    .SET OS_IRQ_EEPROM = _OS_IRQ_RAM_TABLE_SIZE
    .SET _OS_IRQ_RAM_OFFSETS_B0 = _OS_IRQ_RAM_TABLE_SIZE
    _OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+2*_OS_IRQ_RAM_ITEM_SIZE
.ELSE
    .SET _OS_IRQ_RAM_OFFSETS_B0 = 0x00
.ENDIF
;----WATCHDOG-----------------------------------------------
.IF OS_FT_IRQ_WD_BLOCK==0x01
    .SET OS_IRQ_WD = _OS_IRQ_RAM_TABLE_SIZE
    .SET _OS_IRQ_RAM_OFFSETS_B1 = _OS_IRQ_RAM_TABLE_SIZE
    _OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+2*_OS_IRQ_RAM_ITEM_SIZE
.ELSE
    .SET _OS_IRQ_RAM_OFFSETS_B1 = 0x00
.ENDIF
    .db _OS_IRQ_RAM_OFFSETS_B0,_OS_IRQ_RAM_OFFSETS_B1
;----PCINT--------------------------------------------------
.IF _OS_FT_IRQ_PCINT_BLOCK==0x01
    .SET OS_IRQ_PCINT1 = _OS_IRQ_RAM_TABLE_SIZE
    .SET _OS_IRQ_RAM_OFFSETS_B0 = _OS_IRQ_RAM_TABLE_SIZE
    _OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
    .SET OS_IRQ_PCINT2 = _OS_IRQ_RAM_TABLE_SIZE
    .SET _OS_IRQ_RAM_OFFSETS_B1 = _OS_IRQ_RAM_TABLE_SIZE
    _OS_IRQ_RAM_TABLE_SIZE = _OS_IRQ_RAM_TABLE_SIZE+_OS_IRQ_RAM_ITEM_SIZE
.ELSE
    .SET _OS_IRQ_RAM_OFFSETS_B0 = 0x00
    .SET _OS_IRQ_RAM_OFFSETS_B1 = 0x00
.ENDIF
    .db _OS_IRQ_RAM_OFFSETS_B0,_OS_IRQ_RAM_OFFSETS_B1

.ENDIF

.MACRO MCALL
	RCALL @0
.ENDMACRO
.MACRO MJMP
	RJMP @0
.ENDMACRO

;ATOMIC_REQUIRED
.MACRO _OS_POWER_ON
	PUSH ACCUM_L
	LDS ACCUM_L,PRR
	ANDI ACCUM_L,low(~(1<<@0))
	STS PRR,ACCUM_L
	POP ACCUM_L
.ENDMACRO
;ATOMIC_REQUIRED
.MACRO _OS_POWER_OFF
	PUSH ACCUM_L
	LDS ACCUM_L,PRR
	ORI ACCUM_L,low(1<<@0)
	STS PRR,ACCUM_L
	POP ACCUM_L
.ENDMACRO

;ATOMIC_REQUIRED
.MACRO _OS_TIMER_INIT_NR
	_OS_POWER_ON PRTIM0										;Подпитываю TIMER0
	LDI ACCUM_L,(1<<WGM01)|(0<<WGM00)
	STS TCCR0A,ACCUM_L
	LDI ACCUM_L,(0<<CS02)|(1<<CS01)|(0<<CS00)				;/8
	STS TCCR0B,ACCUM_L
	STS TCNT0,C0x00
	LDI ACCUM_L,_OS_TIMER_FREQ-0x01
	STS OCR0A,ACCUM_L
	LDI ACCUM_L,(1<<OCF0A)
	STS TIFR0,ACCUM_L
	LDI ACCUM_L,(1<<OCIE0A)
	STS TIMSK0,ACCUM_L
.ENDMACRO
